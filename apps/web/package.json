{
  "name": "@review-platform/web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "web",
    "sourceRoot": "apps/web/src",
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^default"
        ],
        "options": {
          "cwd": "apps/web",
          "command": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.spec.json"
        }
      }
    }
  },
  "dependencies": {
    "@review-platform/visual-contracts": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "next": "~16.3.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.3"
  }
}

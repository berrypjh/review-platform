{
  "name": "@review-platform/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nx run web:dev",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "e2e": "nx run-many -t e2e",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "tools:check": "tsc -p tools/tsconfig.json && eslint tools && vitest run --config tools/vitest.config.mts",
    "test:hooks": "node --test tools/hooks/*.test.mjs",
    "visual:capture": "tsx tools/visual/capture/cli.ts",
    "visual:compare": "tsx tools/visual/compare/cli.ts",
    "visual:summary": "tsx tools/visual/summary/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/devkit": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/next": "23.2.1",
    "@nx/playwright": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@playwright/test": "^1.63.0",
    "@review-platform/visual-contracts": "workspace:*",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "http-server": "14.1.1",
    "nx": "23.2.1",
    "pixelmatch": "7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "dependencies": {
    "next": "~16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
